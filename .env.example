# Signet — full configuration reference (all parameters).
#
# Copy to `.env` for local development:
#   cp .env.example .env
#
# The first administrator is NOT created via env vars: on first boot (when no
# admin exists) the dashboard redirects to /setup to create it (email, optional
# display name, password).
#
# Uncommented values below are the built-in defaults; commented lines are
# optional and fall back to the default when left unset.

# ── Database ────────────────────────────────────────────────────────────
# PostgreSQL connection string (REQUIRED in practice).
SIGNET_DATABASE_URL=postgres://user:pass@127.0.0.1:5432/signet

# ── HTTP / issuer ───────────────────────────────────────────────────────
# Bind address for the HTTP server.
SIGNET_HTTP_BIND=0.0.0.0:8443

# Public issuer origin clients use to reach this IdP. MUST NOT end with '/'.
SIGNET_ISSUER=http://localhost:8443

# Set the Secure flag on session cookies. Enable in production (HTTPS).
SIGNET_COOKIE_SECURE=false

# ── Keys (auto-generated & persisted under data/ if unset) ─────────────
# PEM path for the RSA JWT signing key.
# SIGNET_JWT_PRIVATE_KEY_PATH=./data/jwt_private.pem
# Path for the AES-256-GCM key used to encrypt TOTP secrets at rest.
# SIGNET_ENCRYPTION_KEY_PATH=./data/encryption.key

# ── Login security & password policy ────────────────────────────────────
# SIGNET_MAX_LOGIN_ATTEMPTS=5
# SIGNET_LOCKOUT_MINUTES=15
# SIGNET_PASSWORD_MIN_LENGTH=10
# SIGNET_PASSWORD_HISTORY_SIZE=3

# ── Rate limiting & audit ───────────────────────────────────────────────
# SIGNET_RATE_LIMIT_PER_MINUTE=300
# SIGNET_AUDIT_RETENTION_DAYS=180

# ── Outbound HTTP policy ────────────────────────────────────────────────
# Outbound requests (webhooks, SSO discovery) refuse destinations resolving to
# private / loopback / link-local addresses, and redirects are not followed.
# Enable this ONLY when webhook receivers live on a trusted intranet: it turns
# the server back into a general-purpose proxy into your own network.
# SIGNET_OUTBOUND_ALLOW_PRIVATE=false

# ── Email (reserved: outbound mail is currently logged only) ────────────
# SIGNET_EMAIL_FROM=signet@localhost
# SIGNET_SMTP_HOST=smtp.example.com
# SIGNET_SMTP_PORT=587

# ── Optional integrations ───────────────────────────────────────────────
# Public base URL used to build absolute links (e.g. password-reset emails).
# SIGNET_PUBLIC_BASE_URL=https://sso.example.com

# One-time seed for the SCIM bearer token (only applied while no token exists
# in the DB). Afterwards rotate it in Admin -> Integrations -> SCIM v2.
# SIGNET_SCIM_BEARER_TOKEN=change-me-scim-token

# ── WebAuthn relying party (override for production) ────────────────────
# RP_ID must be a domain suffix of RP_ORIGIN; production requires HTTPS.

# ── SSO JIT (fallback only) ─────────────────────────────────────────────
# Preferred control: Dashboard → Settings → "JIT provision on SSO"
# (app_settings.sso.jit_provision). Migration 020 seeds that row to true, so
# SIGNET_SSO_JIT_PROVISION is ignored once migrated — turn JIT off in Settings
# (or PATCH /api/v1/admin/settings/sso). Env applies only if the DB row is absent.
# SIGNET_SSO_JIT_PROVISION=false

# ── Sign-in allowlist (fallback only) ────────────────────────────────────
# Only addresses under these email domains may sign in, be provisioned, or be
# synced from a directory. Comma or whitespace separated; exact domains, each
# admitting its real subdomains (mail.corp.example passes, evilcorp.example does
# not). No wildcards. Empty = no restriction. Out-of-list accounts are refused,
# never disabled — this is admission, not ownership (see docs/api-v1.md §14).
#
# Preferred control: Dashboard → Settings → "Email domain allowlist"
# (app_settings.auth.allowed_email_domains). This env var only supplies the
# default while that row is absent; a malformed entry is a startup error rather
# than a silently dropped one. If the list excludes every admin, startup logs a
# warning — nothing inside the product can recover from that.
# SIGNET_ALLOWED_EMAIL_DOMAINS=corp.example,subsidiary.example

# ── Logging ─────────────────────────────────────────────────────────────
# Set to "production" for single-line JSON logs (default: compact text).
# APP_ENV=development
# Override the default filter (info,signet=debug).
# RUST_LOG=info,signet=debug
